# ==== Frontend (Vite) ====
# Bỏ trống nếu chỉ muốn chơi offline (lưu localStorage).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ==== Supabase Edge Functions (KHÔNG đặt trong .env frontend) ====
# Đặt bằng: supabase secrets set TEACHER_KEY=... TEACHER_TOKEN_SECRET=...
# TEACHER_KEY=mat-khau-giao-vien-dai-va-kho-doan
# TEACHER_TOKEN_SECRET=chuoi-bi-mat-ngau-nhien-32-bytes
